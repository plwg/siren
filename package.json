{
  "name": "siren",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bun ./index.html",
    "build": "rm -rf dist && bun build ./index.html ./about/index.html --outdir dist --minify && cp public/og.png dist/og.png && bun scripts/check-csp.ts && bun scripts/check-versions.ts",
    "typecheck": "bun check",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "screenshots": "bun run build && bun scripts/screenshots.ts"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "fflate": "0.8.3",
    "pele": "1.9.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "latest",
    "jsqr": "1.4.0",
    "playwright-core": "1.64.1"
  }
}
